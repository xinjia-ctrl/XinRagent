APP_NAME=ragent-python
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=9090
API_PREFIX=/api/ragent

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragent
REDIS_URL=redis://localhost:6379/0

AUTH_SECRET_KEY=ragent-dev-secret
AUTH_TOKEN_EXPIRE_SECONDS=86400

RAG_VECTOR_TYPE=pg
RAG_DEFAULT_COLLECTION_NAME=rag_default_store
RAG_DEFAULT_DIMENSION=1536
RAG_DEFAULT_TOP_K=5
RAG_SSE_TIMEOUT_MS=300000
RAG_QUEUE_LIMIT_ENABLED=false
RAG_QUEUE_MAX_CONCURRENCY=3
RAG_QUEUE_TIMEOUT_SECONDS=30
RAG_QUEUE_POLL_INTERVAL_SECONDS=0.5
RAG_QUEUE_KEY_PREFIX=ragent:rag:chat
RAG_QUEUE_ACTIVE_TTL_SECONDS=360
RAG_MCP_SERVERS=
RAG_TASK_QUEUE_BACKEND=memory
RAG_TASK_QUEUE_KEY_PREFIX=ragent:tasks
RAG_TASK_VISIBILITY_TIMEOUT_SECONDS=300
RAG_IDEMPOTENCY_TTL_SECONDS=3600
RAG_WORKER_THREAD_POOL_SIZE=8
ROCKETMQ_NAME_SERVER=localhost:9876
ROCKETMQ_PRODUCER_GROUP=ragent-python-producer
ROCKETMQ_TOPIC=ragent-python-task
REQUEST_CONTEXT_TTL_SECONDS=300

UPLOAD_RATE_LIMIT_ENABLED=false
UPLOAD_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_KEY_PREFIX=ragent:upload

MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION_PREFIX=ragent_
MILVUS_METRIC_TYPE=COSINE

INGESTION_STORAGE_DIR=storage/uploads

AI_BAILIAN_URL=https://dashscope.aliyuncs.com
AI_BAILIAN_API_KEY=
AI_SILICONFLOW_URL=https://api.siliconflow.cn
AI_SILICONFLOW_API_KEY=
AI_OLLAMA_URL=http://localhost:11434

AI_CHAT_DEFAULT_MODEL=qwen3-max
AI_EMBEDDING_DEFAULT_MODEL=qwen-emb-8b
AI_RERANK_DEFAULT_MODEL=qwen3-rerank
